<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_auditlog_activity_list" model="ir.ui.view">
        <field name="name">auditlog.activity.list</field>
        <field name="model">auditlog.activity</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="started_at" string="وقت التنفيذ"/>
                <field name="display_summary" string="ملخص الحركة"/>
                <field name="example_document" string="المستند"/>
                <field name="model_name" string="نوع المستند"/>
                <field name="change_details" string="تفاصيل التغيير (من ← إلى)"/>
                <field name="record_count" string="عدد السجلات"/>
                <button name="action_open_document" type="object" string="فتح المستند" icon="fa-external-link"/>
            </list>
        </field>
    </record>
    <record id="view_auditlog_activity_form" model="ir.ui.view">
        <field name="name">auditlog.activity.form</field>
        <field name="model">auditlog.activity</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="action_open_document" type="object" string="فتح المستند" icon="fa-external-link" class="btn-primary"/>
                </header>
                <sheet><group><group>
                    <field name="display_summary" string="ملخص الحركة"/>
                    <field name="example_document" string="المستند"/>
                    <field name="model_name" string="نوع المستند"/>
                    <field name="change_details" string="تفاصيل التغيير (من ← إلى)"/>
                    <field name="operation_summary" string="الحركة"/>
                    <field name="user_id" string="المستخدم"/>
                    <field name="started_at" string="وقت التنفيذ"/>
                </group><group>
                    <field name="record_count" string="عدد السجلات"/>
                    <field name="model_model" invisible="1"/>
                    <field name="resource_ids" invisible="1"/>
                </group></group></sheet>
            </form>
        </field>
    </record>
    <record id="view_auditlog_activity_search" model="ir.ui.view">
        <field name="name">auditlog.activity.search</field>
        <field name="model">auditlog.activity</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="user_id"/><field name="example_document"/>
                <filter name="operations" string="Business Operations" domain="[('kind','=','operation')]"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by':'user_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by':'started_at:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record model="ir.actions.act_window" id="action_auditlog_activity">
        <field name="name">Activity Feed</field>
        <field name="res_model">auditlog.activity</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_auditlog_activity_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No recorded activity yet.</p>
            <p>Business activity is recorded automatically when users create, edit, delete, or export records.</p>
        </field>
    </record>
    <menuitem id="menu_audit_activity" name="Activity Feed"
              parent="menu_audit_monitoring" action="action_auditlog_activity" sequence="10"
              groups="flousflow_auditlog.group_auditlog_user"/>
</odoo>
