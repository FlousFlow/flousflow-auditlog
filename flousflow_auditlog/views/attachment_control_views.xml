<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attachment_control_list" model="ir.ui.view">
        <field name="name">auditlog.attachment.rule.list</field>
        <field name="model">auditlog.attachment.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="model_id"/>
                <field name="stage"/>
                <field name="minimum_count"/>
                <field name="protect_evidence"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_attachment_control_form" model="ir.ui.view">
        <field name="name">auditlog.attachment.rule.form</field>
        <field name="model">auditlog.attachment.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="model_id"/>
                        <field name="stage"/>
                        <field name="active"/>
                        <field name="minimum_count"/>
                <field name="protect_evidence"/>
                        <field name="allow_exception"/>
                        <field name="allowed_mimetypes"/>
                        <field name="model_name" invisible="1"/>
                        <field name="domain_text" string="Apply on" widget="domain" options="{'model': 'model_name', 'in_dialog': True, 'allow_expressions': False}"/>
                        <field name="user_ids" widget="many2many_tags"/>
                        <field name="group_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_attachment_control" model="ir.actions.act_window">
        <field name="name">Attachment Control Rules</field>
        <field name="res_model">auditlog.attachment.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <record id="attachment_rule_company" model="ir.rule">
        <field name="name">Attachment control company scope</field>
        <field name="model_id" ref="model_auditlog_attachment_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <menuitem id="menu_attachment_control" name="Attachment Control"
              parent="menu_audit" action="action_attachment_control"
              groups="flousflow_auditlog.group_document_control_manager" sequence="25"/>
    <record id="view_supporting_evidence_list" model="ir.ui.view">
        <field name="name">ir.attachment.supporting.evidence.list</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false" delete="false">
                <field name="name" readonly="1"/>
                <field name="mimetype" readonly="1"/>
                <field name="file_size" readonly="1"/>
                <field name="ff_audit_evidence"/>
            </list>
        </field>
    </record>
    <record id="compliance_company" model="ir.rule">
        <field name="name">Compliance company scope</field>
        <field name="model_id" ref="model_auditlog_attachment_compliance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="view_compliance_list" model="ir.ui.view">
        <field name="name">auditlog.attachment.compliance.list</field>
        <field name="model">auditlog.attachment.compliance</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date"/><field name="resource_name"/>
                <field name="model_name"/><field name="company_id"/>
                <field name="status"/><field name="rule_name"/><field name="stage"/><field name="user_id"/>
                <field name="required_count"/><field name="actual_count"/>
                <field name="protect_evidence"/>
            </list>
        </field>
    </record>
    <record id="view_compliance_form" model="ir.ui.view">
        <field name="name">auditlog.attachment.compliance.form</field>
        <field name="model">auditlog.attachment.compliance</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false"><sheet><group>
                <field name="create_date"/><field name="resource_name"/>
                <field name="resource_id"/><field name="model_name"/>
                <field name="company_id"/><field name="rule_name"/><field name="rule_domain"/><field name="rule_version"/><field name="allowed_mimetypes"/>
                <field name="stage"/><field name="user_id"/><field name="required_count"/>
                <field name="actual_count"/><field name="protect_evidence"/>
                <field name="status"/><field name="exception_reason"/><field name="exception_approver_id"/><field name="evidence_digest"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="action_compliance" model="ir.actions.act_window">
        <field name="name">Supporting Document Compliance</field>
        <field name="res_model">auditlog.attachment.compliance</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_compliance" name="Document Compliance"
              parent="menu_audit" action="action_compliance"
              groups="flousflow_auditlog.group_document_control_reader" sequence="26"/>
    <record id="exception_company" model="ir.rule">
        <field name="name">Exception company scope</field>
        <field name="model_id" ref="model_auditlog_attachment_exception"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="view_exception_list" model="ir.ui.view">
        <field name="name">auditlog.attachment.exception.list</field>
        <field name="model">auditlog.attachment.exception</field>
        <field name="arch" type="xml">
            <list edit="false" delete="false">
                <field name="rule_id"/><field name="resource_name"/><field name="actor_id"/>
                <field name="approver_id"/><field name="expires_at"/><field name="consumed_at"/>
            </list>
        </field>
    </record>
    <record id="view_exception_form" model="ir.ui.view">
        <field name="name">auditlog.attachment.exception.form</field>
        <field name="model">auditlog.attachment.exception</field>
        <field name="arch" type="xml">
            <form edit="false" delete="false"><sheet><group>
                <field name="rule_id" domain="[('active','=',True),('allow_exception','=',True)]"/>
                <field name="resource_id"/><field name="resource_name"/>
                <field name="actor_id"/><field name="reason"/><field name="expires_at"/>
                <field name="company_id"/><field name="approver_id"/><field name="consumed_at"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="action_exceptions" model="ir.actions.act_window">
        <field name="name">Attachment Exceptions</field>
        <field name="res_model">auditlog.attachment.exception</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_attachment_exceptions" name="Attachment Exceptions" parent="menu_audit"
              action="action_exceptions" groups="flousflow_auditlog.group_attachment_exception" sequence="27"/>
    <record id="view_evidence_upload_form" model="ir.ui.view">
        <field name="name">auditlog.evidence.upload.form</field>
        <field name="model">auditlog.evidence.upload</field>
        <field name="arch" type="xml">
            <form string="Supporting documents">
                <group>
                    <field name="model_name" invisible="1"/>
                    <field name="resource_id" invisible="1"/>
                    <field name="filename" invisible="1"/>
                    <field name="data" filename="filename"/>
                </group>
                <footer>
                    <button name="action_upload" type="object" string="Upload" class="btn-primary"/>
                    <button name="action_existing" type="object" string="Existing attachments" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_control_context_form" model="ir.ui.view">
        <field name="name">auditlog.control.context.form</field>
        <field name="model">auditlog.control.context</field>
        <field name="arch" type="xml">
            <form string="Internal Control" create="false" edit="false">
                <group>
                    <field name="document_name"/>
                    <field name="model_name" invisible="1"/>
                    <field name="can_configure_audit" invisible="1"/>
                    <field name="attachment_status"/>
                    <field name="audit_status" invisible="not can_configure_audit"/>
                </group>
                <footer>
                    <button name="action_attachment_rules" type="object" string="Attachment Control"
                            invisible="attachment_status == 'unsupported'" class="btn-primary"/>
                    <button name="action_audit_rules" type="object" string="Audit Tracking"
                            invisible="not can_configure_audit" class="btn-secondary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
